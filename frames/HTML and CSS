<!DOCTYPE html>
<html>
<head>
  <title>Travel Page</title>
  <style>
    body {
      background-color: #eafaf1;
      font-family: Georgia, serif;
      text-align: center;
      margin: 0;
    }
    header {
      background-color: #2e7d32;
      color: white;
      padding: 30px;
    }
    header h1 {
      margin: 0;
    }
    .destination {
      background-color: white;
      width: 220px;
      display: inline-block;
      margin: 15px;
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0px 2px 6px rgba(0,0,0,0.2);
    }
    .destination h3 {
      color: #2e7d32;
    }
    footer {
      margin-top: 30px;
      padding: 15px;
      background-color: #2e7d32;
      color: white;
    }
  </style>
</head>
<body>

  <header>
    <h1>Explore the World</h1>
    <p>Find your next travel destination</p>
  </header>

  <div class="destination">
    <h3>Mountains</h3>
    <p>Peaceful trails and fresh air.</p>
  </div>

  <div class="destination">
    <h3>Beaches</h3>
    <p>Sunny shores and blue waters.</p>
  </div>

  <div class="destination">
    <h3>Forests</h3>
    <p>Green trees and calm nature.</p>
  </div>

  <footer>
    <p>&copy; 2026 Travel Explorer</p>
  </footer>

</body>
</html>
